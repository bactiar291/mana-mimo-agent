cookies
*.cookies

# Plaintext secret material in any path
*.secret
*.secret.*
*.key
*.key.*
*.pem
*.p12
secrets.*
.env
.env.*
.env.local
.env.production
.cred*
.cred.*

# Runtime / state directories
data/
**/data/
runtime/
**/runtime/

# Session databases, logs, and learning traces
*.log
*.log.*
*.db
*.sqlite
*.sqlite3
agent_runs.jsonl
agent_lessons.jsonl

# Memory dumps and conversation history
memory_dump.json
notes/*.json
*session_export*.json

